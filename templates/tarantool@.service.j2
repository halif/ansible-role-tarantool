[Unit]
Description=Tarantool 3 instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=tarantool
Group=tarantool

WorkingDirectory=/var/lib/tarantool/%i

ExecStart=/usr/bin/tarantool --name %i --config /etc/tarantool/instances.enabled/%i.yaml

Restart=on-failure
RestartSec=5

LimitNOFILE=65535
LimitNPROC=65535

UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tarantool-%i

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

ReadWritePaths=/var/lib/tarantool

[Install]
WantedBy=multi-user.target